<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="favGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0a0f" />
      <stop offset="50%" stop-color="#14172a" />
      <stop offset="100%" stop-color="#050508" />
    </linearGradient>
    <linearGradient id="favNeon" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00ff88" />
      <stop offset="100%" stop-color="#00d2ff" />
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill="url(#favGrad)" stroke="#232742" stroke-width="2"/>
  <!-- Quantum Circuit / Dice Nodes -->
  <circle cx="20" cy="20" r="4.5" fill="#00ff88" />
  <circle cx="44" cy="20" r="4.5" fill="#00d2ff" />
  <circle cx="32" cy="32" r="5" fill="#9d4edd" />
  <circle cx="20" cy="44" r="4.5" fill="#00d2ff" />
  <circle cx="44" cy="44" r="4.5" fill="#00ff88" />
  <!-- Connecting Entropy Lines -->
  <line x1="20" y1="20" x2="32" y2="32" stroke="url(#favNeon)" stroke-width="2.5" opacity="0.8"/>
  <line x1="44" y1="20" x2="32" y2="32" stroke="url(#favNeon)" stroke-width="2.5" opacity="0.8"/>
  <line x1="20" y1="44" x2="32" y2="32" stroke="url(#favNeon)" stroke-width="2.5" opacity="0.8"/>
  <line x1="44" y1="44" x2="32" y2="32" stroke="url(#favNeon)" stroke-width="2.5" opacity="0.8"/>
</svg>
